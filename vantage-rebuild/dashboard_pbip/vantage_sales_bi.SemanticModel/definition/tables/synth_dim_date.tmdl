	partition synth_dim_date = calculated
		mode: import
		source = ```
				
				VAR MinDate =
				    CALCULATE( MIN( fct_transactions[date_key] ), ALL( fct_transactions ) )
				
				VAR MaxDate =
				    CALCULATE( MAX( fct_transactions[date_key] ), ALL( fct_transactions ) )
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Start of Year", DATE(YEAR([Date]), 1, 1),
				    "End of Year", DATE(YEAR([Date]), 12, 31),
				    "Month", MONTH([Date]),
				    "Start of Month", DATE(YEAR([Date]), MONTH([Date]), 1),
				    "End of Month", EOMONTH([Date], 0),
				    "Days in Month", DATEDIFF(DATE(YEAR([Date]), MONTH([Date]), 1), EOMONTH([Date], 0), DAY) + 1,
				    "Year Month Number", YEAR([Date]) & "-" & FORMAT(MONTH([Date]), "00"),
				    "Year Month Name", FORMAT([Date], "YY-MMM"),
				    "Day", DAY([Date]),
				    "Isoday", FORMAT(([Date] - WEEKDAY([Date], 2) + 4), "dddd"),
				    "Day Name", FORMAT([Date], "DDDD"),
				    "Day Name Short", FORMAT([Date], "DDD"),
				    "Day of Week", WEEKDAY([Date], 2),
				    "Day of Year", DATEDIFF(DATE(YEAR([Date]), 1, 1), [Date], DAY) + 1,
				    "Month Year (MM/YY)", FORMAT(MONTH([Date]), "00") & "/" & RIGHT(FORMAT(YEAR([Date]), "0000"), 2),
				    "Month Year Sorter",YEAR([Date]) * 100 + MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "ISO Week Number", WEEKNUM([Date] - WEEKDAY([Date], 2) + 4, 21),
				    "KW", "KW " & FORMAT(WEEKNUM([Date] - WEEKDAY([Date], 2) + 4, 21), "00"),
				    "Year Week Number", FORMAT(WEEKNUM([Date] - WEEKDAY([Date], 2) + 4, 21), "00") & "/" & RIGHT(FORMAT(YEAR([Date] - WEEKDAY([Date], 2) + 4), "0000"), 2),
				    "Year Week Number Sorter", YEAR([Date] - WEEKDAY([Date], 2) + 4) * 100 + WEEKNUM([Date] - WEEKDAY([Date], 2) + 4, 21),
				    "Quarter Number", "Q" & QUARTER([Date]),
				    "Quarter Sorter", QUARTER([Date]),
				    "Quarter Year", "Q" & QUARTER([Date]) & "/" & RIGHT(FORMAT(YEAR([Date]), "0000"), 2),
				    "Quarter Year Sorter", YEAR([Date]) * 10 + QUARTER([Date])
				)
				
				```

	annotation PBI_Id = a8af3463a4e54a79956100a7476f01f6

