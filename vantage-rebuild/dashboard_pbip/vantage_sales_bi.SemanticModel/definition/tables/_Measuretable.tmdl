	/// Measures the year-over-year change in the Returned rate (Returned ACT %) expressed in basis points (bps) by comparing the current period’s return rate to the same period last year.
	measure 'Returned YoY Δ (bps)' =
			
			VAR CurrentRate = [Returned ACT (%)]
			VAR PriorRate =
			    CALCULATE(
			        [Returned ACT (%)],
			        SAMEPERIODLASTYEAR('synth_dim_date'[Date])
			    )
			RETURN
			    (CurrentRate - PriorRate) * 10000
		formatString: 0.0
		displayFolder: 02 - Comparisons\YoY
		lineageTag: 40b7d95f-a9d7-4928-b59e-dafdfd037b7c

	/// Calculates the year-over-year (YoY) percentage change in Actual Profit (€) by comparing the current period’s profit to the profit from the same period last year.
	measure 'Profit ACT YoY %' =
			
			VAR CurrentYear =
			    [Profit ACT (€)]
			
			VAR PrevYear =
			    CALCULATE(
			        [Profit ACT (€)],
			        DATEADD(synth_dim_date[Date], -1, YEAR)
			    )
			
			RETURN
			DIVIDE(CurrentYear - PrevYear, PrevYear)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 02 - Comparisons\YoY
		lineageTag: b7aa9fa7-f579-4085-b737-81cda217a27f

	/// Estimates the profit impact of returned transactions by applying the current CM2 margin (%) to actual gross revenue from returned sales.
	measure 'Returned Profit Impact (€)' =
			
			VAR ReturnedRevenue =
			    CALCULATE(
			        [Gross Revenue ACT (€)],
			        fct_transactions[is_returned] = TRUE()
			    )
			RETURN
			ReturnedRevenue * [CM2 Margin ACT (%)]
		formatString: "€"\ #,0.0;-"€"\ #,0.0;"€"\ #,0.0
		displayFolder: 03 - Business Performance\Profit
		lineageTag: ae13af5b-a0cc-4b96-9697-36399506a1e6

	/// Calculates the maximum Actual AOV (€) within the current selection and adds a 25% buffer for dynamic chart axis scaling.
	measure 'AOV Axis Max (25% buffer)' =
			
			VAR MaxInSelection =
			    MAXX(
			        ALLSELECTED ( synth_dim_date[Date] ),   -- respects slicers + current visual selection
			        [AOV ACT (€)]
			    )
			RETURN
			    MaxInSelection * 1.25
		displayFolder: 99 - Technical Framework\Display Formatting
		lineageTag: de990324-4533-401f-9467-c6ae9e77d5d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Returns a dynamic text summary of currently applied filters for Shop and Business Unit, listing selected values and showing “None” when no relevant filters are applied.
	measure 'Applied Filters' =
			
			VAR ShopFilter =
			    IF (
			        ISFILTERED ( fct_transactions[shop_key] ),
			        "Shop: "
			            & CONCATENATEX (
			                VALUES ( fct_transactions[shop_key] ),
			                fct_transactions[shop_key],
			                ", "
			            )
			    )
			
			VAR BUFilter =
			    IF (
			        ISFILTERED ( dim_products[business_unit] ),
			        "Unit: "
			            & CONCATENATEX (
			                VALUES ( dim_products[business_unit] ),
			                dim_products[business_unit],
			                ", "
			            )
			    )
			
			VAR FilterTable =
			    UNION (
			        ROW ( "F", ShopFilter ),
			        ROW ( "F", BUFilter )
			    )
			
			VAR Result =
			    CONCATENATEX (
			        FILTER ( FilterTable, NOT ISBLANK ( [F] ) ),
			        [F],
			        " • "
			    )
			
			RETURN
			IF ( Result = BLANK (), "Applied Filters: None", "Applied Filters: " & Result )
		displayFolder: 99 - Technical Framework\Display Formatting
		lineageTag: 3ac10927-a4fb-4452-84d8-d02b4ac71998

		annotation PBI_FormatHint = {"isGeneralNumber":true}

