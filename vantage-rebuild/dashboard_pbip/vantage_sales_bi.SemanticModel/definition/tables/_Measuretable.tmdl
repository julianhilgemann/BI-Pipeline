		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Displays the currently selected date range (minimum to maximum date in context) as formatted text.
	measure 'Selected Period (From–To)' =
			
			VAR MinDate =
			    MIN ( 'synth_dim_date'[Date] )
			VAR MaxDate =
			    MAX ( 'synth_dim_date'[Date] )
			
			RETURN
			"Selected Period: "
			    & FORMAT ( MinDate, "dd.MM.yyyy" )
			    & " – "
			    & FORMAT ( MaxDate, "dd.MM.yyyy" )
		displayFolder: 99 - Technical Framework\Display Formatting
		lineageTag: 38f22a96-bca0-4ce5-8539-f53cc51aa38b

