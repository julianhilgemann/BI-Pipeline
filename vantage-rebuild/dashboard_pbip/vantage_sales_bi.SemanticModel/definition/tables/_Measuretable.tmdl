	/// Gross Revenue Δ% YoY Display: Formatted year-over-year revenue change with directional arrow. Display-only string for KPI cards and tooltips. Use the numeric measure for conditional formatting.
	/// 
	measure 'Gross Revenue Δ% YoY Display' = ```
			
			VAR _Value = [Gross Revenue Δ% YoY]
			RETURN
			IF(
			    NOT ISBLANK(_Value),
			    IF(_Value > 0, "▲ ", IF(_Value < 0, "▼ ", "")) 
			        & FORMAT(ABS(_Value), "0.0%"),
			    BLANK()
			)
